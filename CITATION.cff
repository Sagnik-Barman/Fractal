cff-version: 1.2.0
message: >-
  This software implements the method of Kumar, Upadhye & Chand (2025). If you
  use it, please cite that paper (see preferred-citation below). The `authors`
  field lists the authors of this implementation, who are not the authors of
  the method.
title: "RFIF: recurrent fractal interpolation with generalized tempered stable noise (implementation)"
abstract: >-
  Python implementation of recurrent fractal interpolation for weekly NIFTY 50
  data with generalized tempered stable noise, following Kumar, Upadhye & Chand
  (EPJ Special Topics, 2025), together with a Fractal Complexity Coefficient
  analysis and data-driven CTS parameter estimation.
type: software
version: "1.1.0"
date-released: "2026-09-23"
license: MIT
repository-code: "https://github.com/devharish1371/RFIF"

# Authors of this implementation.
authors:
  - family-names: "N"
    given-names: "Devharish"
    # RFIF core, CTS characteristic functions, COS inversion, propagation pipeline
  - family-names: "Aswini"
    given-names: "V J"
    # Fractal Complexity Coefficient modules and FCC-guided regime pipeline
  - family-names: "Barman"
    given-names: "Sagnik"
    affiliation: "Indian Institute of Technology Madras"
    # CTS parameter estimation (cts_fit.py), correctness fixes, offline test suite

keywords:
  - "fractal interpolation"
  - "tempered stable processes"
  - "financial modeling"
  - "NIFTY data"
  - "COS method"
  - "time series analysis"
  - "parameter estimation"

# The method itself. Cite this, not the software.
preferred-citation:
  type: "article"
  authors:
    - family-names: "Kumar"
      given-names: "Mohit"
      affiliation: "Vellore Institute of Technology Chennai"
    - family-names: "Upadhye"
      given-names: "Neelesh S."
      affiliation: "Indian Institute of Technology Madras"
    - family-names: "Chand"
      given-names: "A. K. B."
      affiliation: "Indian Institute of Technology Madras"
  title: "Recurrent fractal interpolation for data with generalized tempered stable noise: an application to NIFTY data"
  journal: "The European Physical Journal Special Topics"
  volume: 234
  issue: 29
  start: 9611
  end: 9629
  year: 2025
  doi: "10.1140/epjs/s11734-025-01639-3"
